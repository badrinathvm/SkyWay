{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Skyway": {
      "deploymentTarget": "27.0",
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Skyway",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "NSLocationWhenInUseUsageDescription": "Skyway uses your location to measure the miles you drive for mileage deductions.",
          "UIBackgroundModes": [
            "location"
          ],
          "NSUserActivityTypes": [
            "app.skyway.viewTrip"
          ],
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": true,
            "UISceneConfigurations": {
              "CPTemplateApplicationSceneSessionRoleApplication": [
                {
                  "UISceneClassName": "CPTemplateApplicationScene",
                  "UISceneConfigurationName": "CarPlay",
                  "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate"
                }
              ]
            }
          }
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.badarinathvm.skyway",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "entitlements": {
        "path": "App/App.entitlements",
        "properties": {
          "com.apple.developer.carplay-driving-task": true
        }
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application",
      "scheme": {
        "commandLineArguments": {
          "-resetTips": false,
          "-showAllTips": false,
          "-simulateDrive": false,
          "-failTripSync": false
        }
      }
    }
  }
}